# Copier en .env.local (ignoré par git) et renseigner avec les valeurs de ton
# projet Supabase : Dashboard → Project Settings → API.
#
# La clé « anon » est publique par conception : elle part dans le bundle du
# navigateur. C'est la RLS qui protège les données, pas le secret de cette clé.
# Ne jamais mettre ici la clé « service_role ».
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
